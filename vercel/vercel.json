{
  "version": 2,
  "name": "routing-magic-desk",
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "env": {
    "PYTHONPATH": "."
  }
}
